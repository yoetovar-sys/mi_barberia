<?xml version="1.0" encoding="utf-8"?>
    
<odoo>
    <!-- Vista Lista (Tabla con badges, avatar y teléfono) -->
    <record id="view_mi_barberia_list" model="ir.ui.view">
        <field name="name">view.mi.barberia.list</field>
        <field name="model">mi.barberia</field>
        <field name="arch" type="xml">
            <list decoration-muted="estado == 'cancelado'" decoration-success="estado == 'atendido'" decoration-info="estado == 'espera'">
                <field name="cliente_id" widget="many2one_avatar"/>
                <field name="telefono"/>
                <field name="tipo_corte"/>
                <field name="precio"/>
                <field name="fecha"/>
                <field name="estado" widget="badge" decoration-muted="estado == 'cancelado'" decoration-success="estado == 'atendido'" decoration-info="estado == 'espera'"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario con Header y Contacto Real -->
    <record id="view_mi_barberia_form" model="ir.ui.view"> 
        <field name="name">view.mi.barberia.form</field>    
        <field name="model">mi.barberia</field>
        <field name="arch" type="xml">    
            <form string="Mi Barbería">
                <header>
                    <!-- Botones de Acción que llaman a los métodos Python -->
                    <button name="action_espera" string="Poner en Espera" type="object" class="oe_highlight" invisible="estado != 'borrador'"/>
                    <button name="action_atendido" string="Marcar Atendido" type="object" class="oe_highlight" invisible="estado != 'espera'"/>
                    <button name="action_cancelado" string="Cancelar Cita" type="object" invisible="estado in ('atendido', 'cancelado')"/>
                    <button name="action_borrador" string="Volver a Borrador" type="object" invisible="estado != 'cancelado'"/>

                    <!-- Barra de Estado (Statusbar) -->
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,espera,atendido"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="cliente_id" string="Cliente"/>
                        <h1>
                            <field name="cliente_id" placeholder="Seleccionar o registrar cliente..." widget="many2one_avatar"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Contacto (Automáticos)">
                            <field name="telefono" widget="phone"/>
                            <field name="correo" widget="email"/>
                        </group>
                        <group string="Servicio de Barbería">
                            <field name="tipo_corte"/>
                            <field name="precio"/>
                            <field name="fecha"/>
                        </group>
                        <group string="Notas y Preferencias">
                            <field name="notas" placeholder="Ej: El cliente prefiere corte a tijera..."/>
                        </group>
                    </group> 
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Kanban Interactiva (Tarjetas estilo Trello con Avatar y Teléfono) -->
    <record id="view_mi_barberia_kanban" model="ir.ui.view">
        <field name="name">view.mi.barberia.kanban</field>
        <field name="model">mi.barberia</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado" sample="1">
                <field name="id"/>
                <field name="cliente_id"/>
                <field name="telefono"/>
                <field name="tipo_corte"/>
                <field name="precio"/>
                <field name="estado"/>
                <field name="fecha"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <div class="d-flex align-items-center gap-2">
                                <field name="cliente_id" widget="many2one_avatar"/>
                                <span class="fw-bold fs-5 text-primary">
                                    <field name="cliente_id"/>
                                </span>
                            </div>
                            <span class="badge text-bg-light border">
                                <field name="tipo_corte"/>
                            </span>
                        </div>
                        <div class="text-muted small mb-1" invisible="not telefono">
                            <i class="fa fa-phone me-1 text-success"/> <field name="telefono"/>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="fa fa-calendar me-1 text-secondary"/> <field name="fecha"/>
                        </div>
                        <footer class="pt-2 mt-auto d-flex justify-content-between align-items-center border-top">
                            <span class="fw-bold text-success fs-6">
                                $<field name="precio"/>
                            </span>
                            <field name="estado" widget="badge" decoration-muted="estado == 'cancelado'" decoration-success="estado == 'atendido'" decoration-info="estado == 'espera'"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
        <!-- Vista Calendario de Citas -->
    <record id="view_mi_barberia_calendar" model="ir.ui.view">
        <field name="name">view.mi.barberia.calendar</field>
        <field name="model">mi.barberia</field>
        <field name="arch" type="xml">
            <calendar string="Agenda de Citas" date_start="fecha" color="estado" mode="month">
                <field name="cliente_id" avatar_field="avatar_128"/>
                <field name="tipo_corte"/>
                <field name="precio"/>
                <field name="estado"/>
            </calendar>
        </field>
    </record>
    
    <record id="action_mi_barberia" model="ir.actions.act_window">
        <field name="name">Mi Barbería</field>
        <field name="res_model">mi.barberia</field>
        <field name="view_mode">kanban,calendar,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Registra tu primer cliente en la barbería!
            </p>
            <p>
                Gestiona los turnos arrastrando las tarjetas entre columnas.
            </p>
        </field>
    </record>

</odoo>
